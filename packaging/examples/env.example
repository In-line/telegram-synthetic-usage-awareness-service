# synthetic-usage-awareness — environment file with secrets.
# Packaged to /etc/default/synthetic-usage-awareness (Debian/RPM).
# Copy to ~/.config/synthetic-usage-awareness/env for user-local installs.
#
# These variables override config.toml values. Keep this file 0600.

# Synthetic API (required)
SYN_AWARENESS_API_KEY=

# Telegram bot (required)
SYN_AWARENESS_BOT_TOKEN=
SYN_AWARENESS_CHAT_ID=
# Optional: forum topic id
SYN_AWARENESS_THREAD_ID=

# Optional overrides
#SYN_AWARENESS_ENABLED=true
#SYN_AWARENESS_API_BASE=https://api.synthetic.new
#SYN_AWARENESS_QUOTAS_PATH=/v2/quotas
#SYN_AWARENESS_TIMEOUT=15.0
#SYN_AWARENESS_REGEN_PERCENT=2.0
#SYN_AWARENESS_REGEN_INTERVAL_HOURS=4.0
#SYN_AWARENESS_THRESHOLD_8H=4.0
#SYN_AWARENESS_THRESHOLD_16H=8.0
#SYN_AWARENESS_THRESHOLD_24H=12.0
#SYN_AWARENESS_LOW_USAGE_THRESHOLD=12.0
#SYN_AWARENESS_NORMAL_INTERVAL_MIN=10.0
#SYN_AWARENESS_LOW_INTERVAL_MIN=1.0
#SYN_AWARENESS_LOG_LEVEL=INFO
